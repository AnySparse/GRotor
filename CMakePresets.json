{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cuda",
      "displayName": "CUDA routing with CPU batching fallback",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/GRotor/sm_89",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GROTOR_ENABLE_RTCORE": "OFF",
        "GROTOR_FULL_COST_REFERENCE": "OFF",
        "GROTOR_BUILD_ROUTING_ABLATION": "OFF",
        "GROTOR_BUILD_CUGR2_ROUTER": "OFF",
        "GROTOR_BUILD_GGR_ROUTER": "OFF",
        "CMAKE_CUDA_ARCHITECTURES": "89",
        "GROTOR_GPU_BACKEND": "CUDA"
      }
    },
    {
      "name": "a100",
      "displayName": "A100 CUDA routing with CPU batching fallback",
      "inherits": "cuda",
      "binaryDir": "${sourceDir}/build/GRotor/sm_80",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "80"
      }
    },
    {
      "name": "h100",
      "displayName": "H100 CUDA routing with CPU batching fallback",
      "inherits": "cuda",
      "binaryDir": "${sourceDir}/build/GRotor/sm_90",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "90"
      }
    },
    {
      "name": "rtx4090",
      "displayName": "RTX 4090 routing with RT-Core batching",
      "inherits": "cuda",
      "binaryDir": "${sourceDir}/build/GRotor/sm_89",
      "cacheVariables": {
        "GROTOR_ENABLE_RTCORE": "ON"
      }
    },
    {
      "name": "rtxpro6000",
      "displayName": "RTX PRO 6000 Blackwell single-GPU routing with RT-Core batching",
      "inherits": "cuda",
      "binaryDir": "${sourceDir}/build/GRotor/sm_120",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "120",
        "GROTOR_ENABLE_RTCORE": "ON",
        "GROTOR_BUILD_MULTIGPU": "OFF",
        "GROTOR_BUILD_INSTANTGR2": "ON"
      }
    },
    {
      "name": "hip",
      "displayName": "AMD HIP with CPU batching fallback (gfx1200)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/hip-cpu",
      "cacheVariables": {
        "GROTOR_GPU_BACKEND": "HIP",
        "CMAKE_HIP_COMPILER": "/opt/rocm/llvm/bin/clang++",
        "CMAKE_HIP_ARCHITECTURES": "gfx1200",
        "GROTOR_ENABLE_RTCORE": "OFF",
        "GROTOR_ENABLE_HIPRT": "OFF",
        "GROTOR_HOST_MEMORY_SAVING": "OFF",
        "GROTOR_BUILD_ROUTING_ABLATION": "OFF"
      }
    },
    {
      "name": "hiprt",
      "displayName": "AMD HIPRT routing (set HIPRT_ROOT)",
      "inherits": "hip",
      "binaryDir": "${sourceDir}/build/hip",
      "cacheVariables": {
        "GROTOR_ENABLE_HIPRT": "ON",
        "HIPRT_ROOT": "$env{HIPRT_ROOT}"
      }
    },
    {
      "name": "rx7900-cpu",
      "displayName": "RX 7900 XTX HIP routing with CPU batching (gfx1100)",
      "inherits": "hip",
      "cacheVariables": {
        "CMAKE_HIP_ARCHITECTURES": "gfx1100"
      }
    },
    {
      "name": "rx7900",
      "displayName": "RX 7900 XTX HIPRT routing (gfx1100; set HIPRT_ROOT)",
      "inherits": "hiprt",
      "cacheVariables": {
        "CMAKE_HIP_ARCHITECTURES": "gfx1100"
      }
    },
    {
      "name": "multi-a100",
      "displayName": "NVSHMEM routing on A100",
      "inherits": "a100",
      "binaryDir": "${sourceDir}/build/GRotor-multi/sm_80",
      "cacheVariables": {
        "GROTOR_BUILD_MULTIGPU": "ON",
        "GROTOR_BUILD_INSTANTGR2": "OFF"
      }
    },
    {
      "name": "multi-h100",
      "displayName": "NVSHMEM routing on H100",
      "inherits": "h100",
      "binaryDir": "${sourceDir}/build/GRotor-multi/sm_90",
      "cacheVariables": {
        "GROTOR_BUILD_MULTIGPU": "ON",
        "GROTOR_BUILD_INSTANTGR2": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cuda",
      "configurePreset": "cuda",
      "jobs": 2,
      "targets": [
        "GRotor",
        "instantgr2_reference",
        "grotor_evaluator"
      ]
    },
    {
      "name": "a100",
      "configurePreset": "a100",
      "jobs": 2,
      "targets": [
        "GRotor",
        "instantgr2_reference",
        "grotor_evaluator"
      ]
    },
    {
      "name": "h100",
      "configurePreset": "h100",
      "jobs": 2,
      "targets": [
        "GRotor",
        "instantgr2_reference",
        "grotor_evaluator"
      ]
    },
    {
      "name": "rtx4090",
      "configurePreset": "rtx4090",
      "jobs": 2,
      "targets": [
        "GRotor",
        "instantgr2_reference",
        "grotor_evaluator"
      ]
    },
    {
      "name": "rtxpro6000",
      "configurePreset": "rtxpro6000",
      "jobs": 2,
      "targets": [
        "GRotor",
        "instantgr2_reference",
        "grotor_evaluator"
      ]
    },
    {
      "name": "hip",
      "configurePreset": "hip",
      "jobs": 2,
      "targets": [
        "GRotor",
        "grotor_evaluator"
      ]
    },
    {
      "name": "hiprt",
      "configurePreset": "hiprt",
      "jobs": 2,
      "targets": [
        "GRotor",
        "grotor_evaluator"
      ]
    },
    {
      "name": "rx7900-cpu",
      "configurePreset": "rx7900-cpu",
      "inherits": "hip"
    },
    {
      "name": "rx7900",
      "configurePreset": "rx7900",
      "inherits": "hiprt"
    },
    {
      "name": "multi-a100",
      "configurePreset": "multi-a100",
      "jobs": 2,
      "targets": [
        "GRotor_multi",
        "grotor_evaluator"
      ]
    },
    {
      "name": "multi-h100",
      "configurePreset": "multi-h100",
      "jobs": 2,
      "targets": [
        "GRotor_multi",
        "grotor_evaluator"
      ]
    }
  ]
}
